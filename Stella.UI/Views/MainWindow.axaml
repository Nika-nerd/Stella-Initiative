<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stella.UI.ViewModels"
        xmlns:local="using:Stella.UI.Views"
        x:CompileBindings="False"
        x:Class="Stella.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Stella" Background="#0B0B0C" RequestedThemeVariant="Dark"
        Width="1150" Height="650">

    <Grid>
        <local:BinaryBackground Name="MatrixBg" />

        <Grid ColumnDefinitions="*, 380" 
              Margin="30" 
              MaxWidth="1600"
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch">
            
            <Grid Grid.Column="0" RowDefinitions="Auto, *" Margin="0,0,25,0">
                
                <Border Grid.Row="0" 
                        Background="#D0151517" 
                        BorderBrush="#252A34" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <StackPanel Spacing="15"> <TextBlock Text="🌟 Stella Project" FontSize="26" Foreground="#61AFEF" FontWeight="SemiBold"/>
        
                        <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                            <TextBox Grid.Column="0" 
                                     Watermark="No Rust project directory selected..." 
                                     Text="{Binding ProjectPath}" 
                                     IsReadOnly="True" 
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     Background="#121214"
                                     BorderBrush="#2D2D2D"/>
                            <Button Grid.Column="1" 
                                    Content="📁 Browse" 
                                    Click="OnSelectFolderClick" 
                                    Margin="12,0,0,0"
                                    Padding="15,0"
                                    Height="38"
                                    VerticalContentAlignment="Center"
                                    Background="#2C313C"
                                    Cursor="Hand"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" Margin="0,5">
                            <TextBlock Grid.Column="0" Text="🤖 Mode:" VerticalAlignment="Center" Foreground="#61AFEF" Margin="0,0,15,0" FontWeight="Medium" FontSize="14"/>
                            <ComboBox Grid.Column="1" 
                                      HorizontalAlignment="Stretch" 
                                      Height="38"
                                      Background="#121214"
                                      BorderBrush="#2D2D2D"
                                      SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="✨ Sandbox Mode (Isolated Generator)"/>
                                <ComboBoxItem Content="📁 Project Mode (Context &amp; File Tree Aware)"/>
                            </ComboBox>
                        </Grid>
        
                        <TextBox Name="InputBox" Text="{Binding UserPrompt, Mode=TwoWay}"
                                 Height="130" Watermark="Enter your task instructions..." 
                                 AcceptsReturn="True" 
                                 TextWrapping="Wrap"
                                 Padding="10"
                                 Background="#121214"
                                 BorderBrush="#2D2D2D"/>
       
                        <Button Name="GenButton" 
                                Click="OnGenButtonClick"
                                IsEnabled="{Binding !IsBusy}"
                                Content="⚡ Generate &amp; Compile" 
                                FontWeight="SemiBold"
                                FontSize="15"
                                Height="42"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#2C313C"
                                Foreground="#98C379"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" 
        Background="#D0151517" 
        BorderBrush="#252A34" 
        BorderThickness="1" 
        CornerRadius="8" 
        Padding="20">
    <Grid RowDefinitions="Auto, Auto, *, Auto"> <TextBlock Grid.Row="0" 
                   Text="{Binding ValidationStatus}" 
                   Foreground="#98C379"  FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,12"
                   HorizontalAlignment="Center"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button Name="CopyButton"
                    Content="📋 Copy Code"
                    Click="OnCopyButtonClick"
                    Padding="14,8"
                    Background="#3E4451"
                    Foreground="White"
                    FontSize="13"
                    Cursor="Hand"/>

            <Button Name="LogButton"
                    Content="⚠️ Show Error Log"
                    Click="OnOpenLogClick"
                    IsEnabled="{Binding HasErrors}"
                    Padding="14,8"
                    Background="#E06C75"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Cursor="Hand"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#111112" CornerRadius="6" BorderBrush="#2D2D2D" BorderThickness="1">
            <ScrollViewer>
                <SelectableTextBlock Name="OutputBlock" Text="{Binding GeneratedCode}" 
                                     FontFamily="Courier New, DejaVu Sans Mono, Monospace"
                                     FontSize="14"
                                     Foreground="#DCDCAA"
                                     Padding="15" 
                                     TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

       
        <Border Grid.Row="3" 
                IsVisible="{Binding IsPendingUserApproval}"
                Background="#1E1E24" 
                BorderBrush="#61AFEF" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="15" 
                Margin="0,15,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ Validation Passed Successfully!" Foreground="#98C379" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="The generated code compiled with no errors and passed all integrated tests. Apply these changes to the source file and rebuild the AST map?" Foreground="#ABB2BF" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Button Content="Reject" 
                            Command="{Binding RejectChangesCommand}" 
                            Background="#3E4451" 
                            Foreground="White" 
                            Padding="12,7"
                            Cursor="Hand"/>
                    <Button Content="Yes, Apply Changes" 
                            Command="{Binding ApplyChangesCommand}" 
                            Background="#61AFEF" 
                            Foreground="#111112" 
                            FontWeight="Bold"
                            Padding="16,7"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
</Border>
            </Grid>

            <Border Grid.Column="1" 
                    Background="#D01A1A1E" 
                    BorderBrush="#252A34" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        
                        <StackPanel Spacing="5">
                            <TextBlock Text="STELLA PROJECT BLUEPRINT" FontSize="11" FontWeight="Bold" Foreground="#61AFEF" LetterSpacing="0.5"/>
                            <Rectangle Height="1" Fill="#252A34" Margin="0,5"/>
                            
                            <TextBlock Text="{Binding ProjectName, FallbackValue='Project: Undefined'}" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{Binding RustEdition, FallbackValue='Edition: unknown'}" Foreground="#8C8C8C" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="📦 Dependencies (Cargo.toml):" Foreground="#9CDCFE" FontSize="13" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding Dependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#CE9178" Margin="10,3,0,3" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="🗂 Module Structure &amp; API:" Foreground="#9CDCFE" FontSize="13" FontWeight="SemiBold"/>
                            
                            <ItemsControl ItemsSource="{Binding Modules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111112" CornerRadius="6" Padding="12" Margin="0,6" BorderBrush="#2D2D2D" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                
                                                <TextBlock Text="{Binding FilePath}" Foreground="#4EC9B0" FontWeight="Bold" FontSize="13"/>
                                                
                                                <TextBlock Text="Internal Imports:" Foreground="#8C8C8C" FontSize="11" Margin="2,4,0,0"/>
                                                <ItemsControl ItemsSource="{Binding InternalImports}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#569CD6" FontSize="11" FontFamily="Consolas,Monospace" Margin="8,2,0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="Detected Public API:" Foreground="#8C8C8C" FontSize="11" Margin="2,4,0,0"/>
                                                <ItemsControl ItemsSource="{Binding PublicApi}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#DCDCDC" FontFamily="Consolas,Monospace" FontSize="11" Margin="8,2,0,2"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
            
        </Grid>

        <Grid Name="ErrorLogOverlay" Background="#C0000000" IsVisible="False">
            <Border Background="#1E1E24" Width="850" Height="500" 
                    CornerRadius="8" BorderBrush="#E06C75" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 10 30 0 #000000">
                <Grid RowDefinitions="Auto, *, Auto" Margin="20">
                    
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📋 Stella Compilation &amp; Diagnostics Journal" FontSize="18" FontWeight="Bold" Foreground="#E06C75"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Click="OnCloseLogClick" Background="Transparent" Foreground="#7F848E" FontSize="16" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#111115" CornerRadius="4" Margin="0,15" BorderBrush="#2D2D30" BorderThickness="1">
                        <ScrollViewer>
                            <SelectableTextBlock Text="{Binding DetailedErrorLog}" 
                                                 FontFamily="Consolas, Courier New, DejaVu Sans Mono, Monospace" 
                                                 FontSize="12" 
                                                 Foreground="#DCDCDC" 
                                                 Padding="15"
                                                 TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="2" Content="Close Journal" Click="OnCloseLogClick" 
                            HorizontalAlignment="Right" Padding="16,8" Background="#3e3e42" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>