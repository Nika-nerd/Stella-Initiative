<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stella.UI.ViewModels"
        x:CompileBindings="False"
        x:Class="Stella.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Stella" Background="#1E1E1E" RequestedThemeVariant="Dark"
        Width="800" Height="600">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="🌟 Stella Project" FontSize="24" Foreground="#61AFEF"/>
            
            
            <TextBox Name="InputBox" Text="{Binding UserPrompt, Mode=TwoWay}"
                     Height="80" Watermark="Введите задачу..."/>
           
            <Button Name="GenButton" 
                   Click="OnGenButtonClick"
                   IsEnabled="{Binding !IsBusy}"
                    Content="Сгенерировать" 
                    HorizontalAlignment="Stretch"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <!-- Блок статуса проверки (ВАЖНО) -->
            <TextBlock Text="{Binding ValidationStatus}" 
                       Foreground="#E06C75" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"/>
            
            <Button Grid.Column="1"
                    Name="CopyButton"
                    Content="Копировать код"
                    
                    Click="OnCopyButtonClick"
                    Padding="10,5"
                    Background="#3e3e42"
                    Foreground="White"
                    FontSize="12"
                    Cursor="Hand"/>

            <Border Background="#1E1E1E" CornerRadius="5" Margin="0, 10, 0,0">
               
                
                <ScrollViewer Height="300">
                    
                    <SelectableTextBlock Name="OutputBlock" Text="{Binding GeneratedCode}" 
                                         FontFamily="Courier New, DejaVu Sans Mono, Monospace"
                                         FontSize="14"
                                         Foreground="#DCDCAA"
                                         Padding="15" 
                                         TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</Window>
